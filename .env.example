# Copy to `.env` and set values. Used by local uvicorn and `./sail` (Docker).
# Restart API/workers after changing values (Docker: `./sail restart api worker-mail`).

# --- Platform ---
ADMIN_TOKEN=
SESSION_SECRET=change-me-session
APP_SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
HOOK_POLL_SECONDS=5
MAIL_POLL_SECONDS=60
DEV_MODE=false
GEMINI_API_KEY=

# --- Gemini models (defaults for new tenants) ---
CHAT_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
REWRITE_MODEL=gemini-2.5-flash

# --- Storage ---
# Local dev (uvicorn):
DATABASE_URL=sqlite:///./data/app.db
# Docker Compose overrides DATABASE_URL to MySQL inside containers.
DATA_ROOT=./data
LANCEDB_ROOT=./data/lancedb

# --- RAG ---
RAG_ENABLED=true
RAG_REWRITE_ENABLED=true
RAG_REWRITE_LANG_FILTER=true
RAG_VERBOSE=false
RETRIEVAL_LANGUAGE=en
RAG_TOP_K=5
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# --- Workers ---
ORDER_MODIFICATION_WINDOW_HOURS=6

# --- MySQL (Docker Compose) ---
# Used by db service and to build DATABASE_URL in api/worker containers.
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=chatbot
MYSQL_USER=chatbot
MYSQL_PASSWORD=chatbot

# --- OAuth / public URL ---
# QuickBooks OAuth redirects. Set when behind a reverse proxy if request.base_url is wrong.
PUBLIC_BASE_URL=

# --- Channel credentials (optional env fallbacks only) ---
# Prefer dashboard → bot → Connectors (per slug).
# Webhooks: https://<host>/webhooks/whatsapp/{slug}, /messenger/{slug}, /instagram/{slug}
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ADMIN_WA_ID=
MESSENGER_VERIFY_TOKEN=
MESSENGER_PAGE_ACCESS_TOKEN=
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_IG_USER_ID=

# --- Dev: Streamlit chat widget (apps/streamlit_chat.py) ---
TENANT_SLUG=
TENANT_TOKEN=

# --- Dev: GreenMail integration tests (pytest, optional) ---
# Example: GREENMAIL_SMTP=127.0.0.1:3025
GREENMAIL_SMTP=

# --- Dev: email testing ---
# DEV_MODE=true enables dashboard "Test email" tab and detailed API errors.
# Start stack: ./sail up -d --profile dev  (GreenMail IN + Mailpit OUT)
# See docs/dev/greenmail.md for connector values.
# DEV_MAIL_INJECT_SMTP_HOST=greenmail
# DEV_MAIL_INJECT_SMTP_PORT=3025
# DEV_MAILPIT_WEB_URL=http://127.0.0.1:8025
