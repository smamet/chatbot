# Copy to `.env` and set values. Most vars reload when `.env` is saved (mtime);
# DATABASE_URL still needs an API restart after change.

# --- App ---
# When set, POST /v1/chat requires header: Authorization: Bearer <same value>.
# Leave empty for local dev without a header. Use a long random string in production.
CHAT_API_SECRET=
# Extra logging / dev behaviour when true (e.g. API error details). When RAG is on, true
# also includes source paths in retrieved context so replies may name files; false omits
# paths and instructs the model not to show (Source: …) to customers.
DEV_MODE=false
# Google AI / Gemini API key (required for chat and embeddings).
GEMINI_API_KEY=

# --- Gemini models ---
CHAT_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
# Model used for optional RAG query rewrite step.
REWRITE_MODEL=gemini-2.5-flash

# --- Storage ---
DATABASE_URL=sqlite:///./data/app.db
LANCEDB_PATH=./data/lancedb
PROMPT_PATH=./prompts/system.md

# --- RAG (LanceDB) ---
RAG_ENABLED=false
# When RAG is on, call LLM to rewrite user query for retrieval (before embed/search).
RAG_REWRITE_ENABLED=true
# When true, that rewrite runs only if a Creole marker token matches (see creole_script_heuristic.py).
RAG_REWRITE_LANG_FILTER=false
# Log RAG / rewrite gate decisions to the console.
RAG_VERBOSE=false
RETRIEVAL_LANGUAGE=en
RAG_TOP_K=5
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# --- WhatsApp Cloud API (Meta) — optional ---
# Webhook URL path on this API: GET+POST /webhooks/whatsapp (HTTPS public URL in prod, e.g. ngrok).
# You choose this string; it must match exactly the "Verify token" in Meta Developer → WhatsApp → Webhook.
WHATSAPP_VERIFY_TOKEN=
# Meta app → Settings → Basic → App secret. This is the same Meta signature secret for
# POST /webhooks/whatsapp, /webhooks/messenger, and /webhooks/instagram.
WHATSAPP_APP_SECRET=
# Meta Developer → WhatsApp → API Setup (temporary token) or a long-lived System User token for production.
WHATSAPP_ACCESS_TOKEN=
# WhatsApp → API Setup: "Phone number ID" (Graph API id), not your personal phone number.
WHATSAPP_PHONE_NUMBER_ID=
# Admin recipient WA id for create/update/delete notifications.
WHATSAPP_ADMIN_WA_ID=
# Window where update/delete can affect latest pending order.
ORDER_MODIFICATION_WINDOW_HOURS=6

# --- Facebook Messenger (Meta) ---
# Optional; if blank, /webhooks/messenger uses WHATSAPP_VERIFY_TOKEN for GET verification.
MESSENGER_VERIFY_TOKEN=
# Messenger replies use a Page access token (Graph /me/messages), not WHATSAPP_ACCESS_TOKEN.
MESSENGER_PAGE_ACCESS_TOKEN=EAAxpuizTjmYBRbpiMeyJbiXURFZAORhBZBv7SwDWJ27aYRmD2eN5MRpa6t1UPKgrdkgq76qFiDZAB8brNFI58pt2AzMievs0qgIOtOmZC460zkm6DPSFYJnTvP8LZAqjavKiYTE7uio1QLRq347nZBvB5FfQrn4ZAzDbYD7E0ZClbBPTX3edjInZAkbv1dAPGqSpPBm5lYAZDZD

# --- Instagram Messaging (Meta) ---
# Optional; if blank, /webhooks/instagram uses WHATSAPP_VERIFY_TOKEN for GET verification.
INSTAGRAM_VERIFY_TOKEN=
# Access token and Instagram Professional user id used for send endpoint:
# POST https://graph.instagram.com/v*/{INSTAGRAM_IG_USER_ID}/messages
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_IG_USER_ID=
