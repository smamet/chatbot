# Copy to `.env` and set values. Most vars reload when `.env` is saved (mtime);
# DATABASE_URL still needs an API restart after change.

# --- App ---
# When set, POST /v1/chat requires header: Authorization: Bearer <same value>.
# Leave empty for local dev without a header. Use a long random string in production.
CHAT_API_SECRET=62WegzC4WFF56MVpgUG3V77GZ
# Extra logging / dev behaviour when true (e.g. API error details). When RAG is on, true
# also includes source paths in retrieved context so replies may name files; false omits
# paths and instructs the model not to show (Source: …) to customers.
DEV_MODE=false
# Google AI / Gemini API key (required for chat and embeddings).
GEMINI_API_KEY=

# --- Gemini models ---
CHAT_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
# Model used for optional RAG query rewrite step.
REWRITE_MODEL=gemini-2.0-flash

# --- Storage ---
DATABASE_URL=sqlite:///./data/app.db
LANCEDB_PATH=./data/lancedb
PROMPT_PATH=./prompts/system.md

# --- RAG (LanceDB) ---
RAG_ENABLED=false
# When RAG is on, call LLM to rewrite user query for retrieval (before embed/search).
RAG_REWRITE_ENABLED=true
# When true, that rewrite runs only if a Creole marker token matches (see creole_script_heuristic.py).
RAG_REWRITE_LANG_FILTER=false
# Log RAG / rewrite gate decisions to the console.
RAG_VERBOSE=false
RETRIEVAL_LANGUAGE=en
RAG_TOP_K=5
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# --- WhatsApp Cloud API (Meta) — optional ---
# Webhook URL path on this API: GET+POST /webhooks/whatsapp (HTTPS public URL in prod, e.g. ngrok).
# You choose this string; it must match exactly the "Verify token" in Meta Developer → WhatsApp → Webhook.
WHATSAPP_VERIFY_TOKEN=
# Meta app → Settings → Basic → App secret. If set, POST /webhooks/whatsapp must have valid X-Hub-Signature-256.
WHATSAPP_APP_SECRET=
# Meta Developer → WhatsApp → API Setup (temporary token) or a long-lived System User token for production.
WHATSAPP_ACCESS_TOKEN=
# WhatsApp → API Setup: "Phone number ID" (Graph API id), not your personal phone number.
WHATSAPP_PHONE_NUMBER_ID=
