# Copy to `.env` and set values. Used by local uvicorn and `./sail` (Docker).

# --- Platform ---
ADMIN_TOKEN=
SESSION_SECRET=change-me-session
APP_SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
HOOK_POLL_SECONDS=5
DEV_MODE=false
GEMINI_API_KEY=

# --- Gemini models (defaults for new tenants) ---
CHAT_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
REWRITE_MODEL=gemini-2.5-flash

# --- Storage ---
# Local dev:
DATABASE_URL=sqlite:///./data/app.db
# Docker Compose overrides this to MySQL inside containers.
DATA_ROOT=./data
LANCEDB_ROOT=./data/lancedb

# --- RAG ---
RAG_ENABLED=true
RAG_REWRITE_ENABLED=true
RAG_REWRITE_LANG_FILTER=true
RAG_VERBOSE=false
RETRIEVAL_LANGUAGE=en
RAG_TOP_K=5
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# --- Automation worker ---
ORDER_MODIFICATION_WINDOW_HOURS=6

# --- MySQL (Docker Compose) ---
# MYSQL_ROOT_PASSWORD=rootpass
# MYSQL_DATABASE=chatbot
# MYSQL_USER=chatbot
# MYSQL_PASSWORD=chatbot

# Channel credentials: dashboard → bot → Connectors (per slug).
# Webhooks: https://<host>/webhooks/whatsapp/{slug}, /messenger/{slug}, /instagram/{slug}

# Public URL for OAuth redirects (QuickBooks). Set when behind a reverse proxy if request.base_url is wrong.
# PUBLIC_BASE_URL=https://your-domain.com
